{
  "name": "cfw-fileup",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm run --filter app dev",
    "build": "pnpm run --filter app build",
    "deploy": "pnpm run --filter app deploy",
    "test": "pnpm -w -r test",
    "test:e2e": "pnpm --filter app test:e2e",
    "test:e2e:fresh": "pnpm --filter app test:e2e:fresh",
    "typecheck": "pnpm --filter app typecheck",
    "typecheck:all": "pnpm --filter app typecheck:worker && pnpm --filter app typecheck:client && pnpm --filter app typecheck:sw",
    "lint": "pnpm --filter app eslint src/worker/",
    "check": "pnpm lint && pnpm test && pnpm typecheck:all"
  },
  "dependencies": {
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "wrangler": "^4.4.0"
  }
}
