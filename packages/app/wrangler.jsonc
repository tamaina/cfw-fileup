{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfw-fileup",
  "main": "src/worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/api.json",
      "/api-doc",
      "/upload/*",
      "/v/*",
      "/d/*",
      "/e/*",
      "/a/*",
      "/ping",
      "/id"
    ]
  },
  "compatibility_date": "2026-05-11",
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    // Google OAuth - set GOOGLE_CLIENT_ID here (not a secret)
    // Set GOOGLE_CLIENT_SECRET in .dev.vars for local dev, or as a Worker secret in production
    "GOOGLE_CLIENT_ID": "",
    // Optional: override the OAuth redirect URI (default: auto-detected from request URL)
    "GOOGLE_REDIRECT_URI": "",
    "MAIL_FROM": "",
    "PUBLIC_APP_URL": ""
  },
  "send_email": [
    {
      "name": "MAILER"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "734001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "FILE_PASSPHRASE_RATE_LIMITER",
      "namespace_id": "734002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_FORM_RATE_LIMITER",
      "namespace_id": "734003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "cfw-fileup-storage"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfw-fileup-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
