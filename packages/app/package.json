{
  "name": "app",
  "type": "module",
  "scripts": {
    "postinstall": "pnpm generate:viem-chain-assets && (playwright install chromium --with-deps || playwright install chromium || echo 'Playwright browser install skipped (unsupported platform)')",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:config": "bash scripts/deploy-with-config.sh",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p ./src/worker/tsconfig.json --noEmit",
    "typecheck:client": "vue-tsc -p ./src/client/tsconfig.json --noEmit",
    "typecheck:sw": "tsc -p ./src/sw/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:worker:watch": "vitest --config vitest.worker.config.ts",
    "eslint": "eslint src/worker src/shared src/sw test scripts *.config.ts",
    "eslint:fix": "eslint src/worker src/shared src/sw test scripts *.config.ts --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cfw-fileup-db --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1",
    "cf-typegen": "wrangler types ./src/worker/worker-configuration.d.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:fresh": "pnpm db:reset && pnpm db:migrate:local && pnpm test:e2e",
    "playwright:install": "playwright install chromium",
    "playwright:install-deps": "playwright install-deps chromium",
    "screenshot": "tsx scripts/screenshot-pr.ts",
    "generate:viem-chain-assets": "tsx scripts/generate-viem-chain-assets.ts"
  },
  "dependencies": {
    "@browser-mc/browser-image-resizer-ex": "^1.0.0",
    "@browser-mc/browser-movie-converter": "^1.3.0",
    "@hono/standard-validator": "^0.2.2",
    "@lucide/vue": "^1.17.0",
    "@pdfme/common": "^6.1.5",
    "@pdfme/generator": "^6.1.5",
    "@pdfme/schemas": "^6.1.5",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "@tanstack/vue-query": "^5.101.0",
    "@valibot/to-json-schema": "^1.7.1",
    "@vuetify/v0": "1.0.0-alpha.4",
    "@wagmi/vue": "^0.5.17",
    "@walletconnect/ethereum-provider": "^2.23.9",
    "@zip.js/zip.js": "^2.8.26",
    "bgzf": "workspace:*",
    "dompurify": "^3.4.9",
    "exifreader": "^4.41.0",
    "hls.js": "1.7.0-beta.1",
    "hono-openapi": "^1.3.0",
    "ipaddr.js": "^2.4.0",
    "magic-bytes.js": "^1.13.0",
    "marked": "^18.0.5",
    "mediabunny": "^1.46.0",
    "mrmime": "^2.0.1",
    "range-parser": "^1.2.1",
    "shiki": "^4.2.0",
    "valibot": "^1.4.1",
    "vanilla-jsoneditor": "^3.12.0",
    "viem": "^2.52.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.1",
    "@cloudflare/vitest-pool-workers": "^0.16.14",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@misskey-dev/eslint-plugin": "^2.2.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/range-parser": "^1.2.7",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "eventemitter3": "^5.0.4",
    "hono": "^4.12.25",
    "nanoid": "^5.1.11",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "vue": "^3.5.37",
    "vue-tsc": "^3.3.4",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.99.0"
  }
}
